    "verify:eval-inventory": "node scripts/verify-eval-inventory.js",
    "verify:links": "node scripts/check-doc-links.js",
    "verify:supply-chain": "node scripts/verify-supply-chain.js",
    "verify:release": "node scripts/verify-release.js",
    "smoke:package": "node scripts/smoke-package-install.js",
