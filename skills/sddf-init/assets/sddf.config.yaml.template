# Valores por defecto para todos los tipos
# este archivo debe diseñarse y reconstruiserse para ser fácilmente extendible y adaptable a diferentes proyectos y tecnologías
# Raíz versionada de los artefactos SDDF. SDDF_ROOT solo la sobrescribe si es válido.
root: docs
profile: core
stack: node-markdown

defaults:
  delivery-model: batch # batch | continuous

verify:
  unit:
    command: "pnpm run test:unit"
    required: false
  component:
    command_template: "pnpm run test:component:file -- {{test_file_path}}"  # pnpm test:component:file packages\ui\src\components\Alert\Alert.test.tsx
    required: false
  integration:
    command: "pnpm run test:integration"
    required: false
  contract:
    command: "pnpm run test:contract"
    required: false
  e2e:
    command: "pnpm run test:e2e:smoke"
    required: false
  e2e-smoke:
    command: "pnpm run test:e2e:smoke"
    required: false
  e2e-sanity:
    command: "pnpm run test:e2e:sanity"
    required: false
  e2e-regression:
    command: "pnpm run test:e2e:regression"
    required: false
  e2e-single: # Ejecuta un solo archivo de feature con Cucumber, ideal para la etapa de implementación y debugging
    command: "pnpm exec cucumber-js --profile single {{test_file_path}}" # pnpm exec cucumber-js --profile single tests/e2e/features/components/switch.feature
    required: false
  performance:
    command: "pnpm run test:performance"
    required: false
  eval:
    command: "pnpm run test:eval"
    required: false

implement:
  test_generators:
    - type: component
      skill: none # test-react-testing-library
      required: false
    - type: e2e
      skill: none # test-e2e-playwright-cucumber
      required: false
    - type: eval
      skill: none # skill-test-evals
      required: false

  # Contexto E2E del proyecto — leído por story-implement para enriquecer el bundle
  # del test_generator de tipo e2e. Si se omite, el subagente explora el proyecto.
  e2e_context:
    framework: cucumber                                    # cucumber | playwright | cypress
    base_path: tests/e2e                         # Raíz relativa del directorio E2E
    features_path: tests/e2e/features # Donde van los *.feature files
    steps_path: tests/e2e/step_definitions  # Step definitions
    pages_path: tests/e2e/pages                  # Page Objects
    support_path: tests/e2e/support              # Hooks y World

  code_generators:
    - layer: monolithic
      skill: none # skill-master
      required: false
    - layer: frontend
      skill: none # code-frontend-library-react
      required: false
    - layer: backend
      skill: none
      required: false
    - layer: database
      skill: none
      required: false

# DoD de historia por etapa (STORY-101): etapa → slug del guardrail en $SPECS_BASE/guardrails/<slug>.md.
# Opcional: sin esta sección cada skill usa la convención dod-story-<etapa>.md. Un proyecto
# consumidor sobrescribe aquí una etapa (p. ej. implement: dod-story-implement-acme) sin tocar skills.
guardrails:
  dod:
    story:
      specify: dod-story-specify
      plan: dod-story-plan
      implement: dod-story-implement
      code-review: dod-story-code-review
      verify: dod-story-verify
      acceptance: dod-story-acceptance
      deliver: dod-story-deliver
