      "input": {
        "invocation": "/epic-validate EPIC-30",
        "mode": "manual",
        "epics_dirs": ["specs/flow/EPIC-30-ejemplo/", "specs/flow/EPIC-300-otra/"],
        "epic_md_path": "specs/flow/EPIC-30-ejemplo/epic.md",
        "epic_md_lines": [
          "1: ---", "2: type: epic", "3: id: EPIC-30", "4: title: \"Épica de ejemplo\"", "5: status: DEVELOP", "6: substatus: IN-PROGRESS", "7: ---",
          "8: # Épica: Épica de ejemplo",
