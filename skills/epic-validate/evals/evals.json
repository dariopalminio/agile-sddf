          { "path": "specs/flow/archive/2026-10-05-STORY-202-filtrar-clientes/story.md", "parent": "EPIC-30-ejemplo", "status": "COMPLETED", "substatus": "DONE" },
          { "path": "specs/flow/STORY-305-otra-historia/story.md", "parent": "EPIC-300-otra", "status": "IMPLEMENT", "substatus": "IN-PROGRESS" }
        ],
        "epic_analyze_report": { "path": "specs/flow/EPIC-30-ejemplo/epic-analyze-report.md", "verdict": "APPROVED", "updated": "2026-10-20" },
        "templates": {
          "docs/templates/epic-template.md": "existe; declara '## Historias' con 'clave: historias'",
          "docs/templates/epic-validate-report-template.md": "no existe",
